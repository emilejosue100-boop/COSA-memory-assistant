PORT=5000
# CockroachDB connection string (PostgreSQL wire protocol)
COCKROACH_DB_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
JWT_SECRET=change-me-in-production
GEMINI_API_KEY=your-gemini-api-key
# Optional override when free-tier quota differs by model
# GEMINI_MODEL=gemini-2.0-flash-lite
FIRECRAWL_API_KEY=your-firecrawl-api-key
FRONTEND_URL=http://localhost:5173
# Production example (no trailing slash): https://kumbuka.vercel.app
ADMIN_PHONE=0788123456
# Optional demo account overrides (defaults: admin 0788123456, member 0788111111, PIN 1234)
# DEMO_ADMIN_PHONE=
# DEMO_MEMBER_PHONE=
# DEMO_PIN=
# Cohere — note + question embeddings (embed-english-v3.0, 1024 dimensions)
COHERE_API_KEY=your-cohere-api-key
# Amazon Bedrock — Claude for grounded answers
AWS_REGION=us-east-1
# Must match a model enabled in your Bedrock console for AWS_REGION
# Examples: anthropic.claude-opus-4-6-v1, anthropic.claude-opus-4-8, us.anthropic.claude-opus-4-8
BEDROCK_MODEL_ID=anthropic.claude-opus-4-6-v1
# Enable read-only MCP tool-use path (required for Cooperative Risk Watch scans)
ENABLE_MCP_TOOL_USE=false
# Groq Whisper — admin voice question input (Memory Assistant Q&A panels)
# Sign up free at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Optional S3 bucket (not used by voice transcription; kept for other AWS integrations)
# VOICE_NOTES_S3_BUCKET=cosa-voice-notes
